{
  "name": "erp-da-vinci",
  "private": true,
  "description": "Monorepo do ERP-DA-VINCI — workspace TypeScript (pnpm + Turborepo). Serviços Java usam Gradle, fora deste workspace.",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
