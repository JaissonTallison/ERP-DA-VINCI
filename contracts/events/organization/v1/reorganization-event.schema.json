{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:davinci:contracts:events:organization:v1:reorganization-event",
  "title": "Evento de reorganização (CloudEvents 1.0, modo estruturado)",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "dataschema",
    "subject",
    "tenantid",
    "correlationid",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "const": "/data-plane/organization"
    },
    "type": {
      "enum": [
        "br.com.davinci.organization.reorganization.submitted.v1",
        "br.com.davinci.organization.reorganization.applied.v1",
        "br.com.davinci.organization.reorganization.rejected.v1",
        "br.com.davinci.organization.reorganization.cancelled.v1"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "urn:davinci:contracts:events:organization:v1:reorganization-event"
    },
    "subject": {
      "type": "string",
      "format": "uuid"
    },
    "tenantid": {
      "type": "string",
      "format": "uuid"
    },
    "correlationid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "data": {
      "type": "object",
      "required": [
        "reorganizationId",
        "tenantId",
        "structureId",
        "description",
        "effectiveOn",
        "status",
        "submittedBy",
        "decidedBy",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "reorganizationId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "structureId": {
          "type": "string",
          "format": "uuid"
        },
        "description": {
          "type": "string"
        },
        "effectiveOn": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": ["DRAFT", "PENDING_APPROVAL", "APPLIED", "REJECTED", "CANCELLED"]
        },
        "submittedBy": {
          "type": ["string", "null"]
        },
        "decidedBy": {
          "type": ["string", "null"]
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
