{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:davinci:contracts:events:organization:v1:economic-group-event",
  "title": "Evento de economic-group (CloudEvents 1.0, modo estruturado)",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "dataschema",
    "subject",
    "tenantid",
    "correlationid",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "const": "/data-plane/organization"
    },
    "type": {
      "enum": [
        "br.com.davinci.organization.economic-group.created.v1",
        "br.com.davinci.organization.economic-group.updated.v1",
        "br.com.davinci.organization.economic-group.closed.v1"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "urn:davinci:contracts:events:organization:v1:economic-group-event"
    },
    "subject": {
      "type": "string",
      "format": "uuid"
    },
    "tenantid": {
      "type": "string",
      "format": "uuid"
    },
    "correlationid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "data": {
      "$ref": "#/$defs/economicGroup"
    }
  },
  "$defs": {
    "economicGroup": {
      "type": "object",
      "required": [
        "economicGroupId",
        "tenantId",
        "code",
        "name",
        "referenceCurrency",
        "referenceTimezone",
        "status",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "economicGroupId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "referenceCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "referenceTimezone": {
          "type": "string"
        },
        "status": {
          "enum": ["ACTIVE", "CLOSED"]
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
