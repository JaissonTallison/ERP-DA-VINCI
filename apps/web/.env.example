# Variáveis do servidor do frontend (BFF). Em `pnpm dev` todas têm padrão apontando para o compose.yaml;
# em produção (`next start` / imagem) são obrigatórias. Nunca versione valores reais.
APP_URL=http://localhost:5620
OIDC_ISSUER=http://localhost:5607/realms/davinci
OIDC_CLIENT_ID=davinci-web
OIDC_CLIENT_SECRET=davinci_web_dev_secret
REDIS_URL=redis://localhost:5601
SESSION_IDLE_SECONDS=1800
SESSION_MAX_SECONDS=36000
